generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  queued
  retry
  sending
  sent
  failed
  unknown
}

enum PushStatus {
  queued
  sending
  retry
  sent
  failed
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id        String      @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  domain    String?
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  apiKeys   ApiKey[]
  smtp      SmtpConfig?
  emails    Email[]
  pushSubscriptions PushSubscription[]
  pushNotifications PushNotification[]

  @@index([ownerId])
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  keyHash   String    @unique
  lastFour  String
  projectId String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model SmtpConfig {
  id                String   @id @default(cuid())
  projectId         String   @unique
  host              String
  port              Int
  secure            Boolean  @default(false)
  user              String
  token             String
  encryptedPassword String
  iv                String
  authTag           String
  email             String
  company           String
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
}

model Email {
  id             String      @id @default(cuid())
  projectId      String
  requestId      String
  event          String
  recipientEmail String
  subject        String
  body           String
  payload        Json
  status         EmailStatus @default(queued)
  attempts       Int         @default(0)
  messageId      String?
  error          String?
  lastAttemptAt  DateTime?
  idempotencyKey String
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, requestId])
  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
}

model PushNotification {
  id             String     @id @default(cuid())
  projectId      String
  userId         String
  requestId      String
  header         String
  body           String
  organization   String
  payload        Json
  status         PushStatus @default(queued)
  attempts       Int        @default(0)
  error          String?
  idempotencyKey String
  sentAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, requestId])
  @@index([projectId, userId, createdAt])
  @@index([status, updatedAt])
}
